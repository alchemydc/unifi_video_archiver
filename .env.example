# Logging
LOG_LEVEL=debug  # debug, info, warn, error

# UniFi NVR
UNIFI_HOST=192.168.1.1
UNIFI_USER=admin
UNIFI_PASS=secret

# Storage
STORAGE_TYPE=fs  # fs, r2, s3
OUTPUT_DIR=./clips

# Capture timing
CAPTURE_PRE_BUFFER_SECONDS=10
CAPTURE_POST_BUFFER_SECONDS=20
SETTLING_DELAY_SECONDS=5

# Server
WEBHOOK_PORT=3000
